# Copia este archivo como .env.local y rellena los valores.

# Número de WhatsApp del cliente, con código de país y sin "+", espacios ni guiones (ej. 13055550123)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Dirección pública de la web (para las imágenes al compartir en redes)
NEXT_PUBLIC_SITE_URL=https://theheuresociety.com
