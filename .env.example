# Copia este archivo como .env.local y rellena los valores.
# En Vercel, añade las mismas variables en Settings → Environment Variables.

# Número de WhatsApp del cliente, con código de país y sin "+", espacios ni guiones (ej. 13055550123)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Dirección pública de la web
NEXT_PUBLIC_SITE_URL=https://theheuresociety.vercel.app

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: solo en el servidor, nunca en el navegador
SUPABASE_SECRET_KEY=

# Robot de Telegram (token de @BotFather)
TELEGRAM_BOT_TOKEN=
# Cualquier texto largo y aleatorio; protege la dirección del robot
TELEGRAM_WEBHOOK_SECRET=
# IDs de Telegram autorizados a publicar, separados por comas (el robot te dice el tuyo)
TELEGRAM_ADMIN_IDS=

# Clave de la API de Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Recorte automático para el estuche (fal.ai → Dashboard → API Keys). Sin ella, los relojes
# nuevos salen en la colección pero no en el estuche.
FAL_KEY=

# Chatbot de WhatsApp (Cloud API de Meta o un proveedor compatible como 360dialog)
# Meta: https://graph.facebook.com/v26.0 · 360dialog: https://waba-v2.360dialog.io
WHATSAPP_API_BASE=https://graph.facebook.com/v26.0
# Token de acceso (Meta: token de usuario del sistema; 360dialog: su API key)
WHATSAPP_TOKEN=
# Solo con Meta: id del número y secreto de la app (para verificar la firma de cada llamada)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Cualquier texto largo y aleatorio; se escribe también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# App de Meta propia (Tech Provider): id de la app y de la configuración de Embedded Signup
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_ES_CONFIG_ID=
# Clave para abrir /es/admin/whatsapp?key=… (texto largo y aleatorio)
WHATSAPP_ONBOARD_KEY=

# CRM (/admin): correos autorizados, separados por comas. Los usuarios se crean con
#   node --env-file=.env.local scripts/crm-user.mjs
CRM_ADMIN_EMAILS=

# Redes (Instagram y Facebook): usa NEXT_PUBLIC_META_APP_ID y WHATSAPP_APP_SECRET de la misma app de Meta.
# Opcional: configuración de «Facebook Login for Business» (si no, se piden los permisos directamente)
NEXT_PUBLIC_META_LOGIN_CONFIG_ID=
# Clave para la actualización diaria de métricas (Vercel Cron), texto largo y aleatorio
CRON_SECRET=
